{
  "name": "celestial-haven",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.domain.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:m1-build": "npm run build && npm run test:e2e -- tests/e2e/boot.spec.ts tests/e2e/m1-acceptance.spec.ts",
    "build": "npm run validate:content && npm run validate:maps && vite build",
    "preview": "vite preview",
    "validate:content": "node tools/validate-content.ts",
    "check:deps": "node tools/check-dep-age.ts",
    "validate:maps": "node tools/validate-maps.ts",
    "test:prototype": "playwright test --config=playwright.prototype.config.ts",
    "generate:maps": "node tools/gen-blockout-maps.ts",
    "check:maps": "node tools/gen-blockout-maps.ts --check"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
